# --- Voice: Agora Conversational AI + Murf Falcon TTS --------------------------
# Agora console (console.agora.io): create a project, enable Conversational AI,
# copy the App ID and App Certificate. RESTful API > add a secret for the Customer ID/Secret.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Murf dashboard (murf.ai/api) > API keys. Falcon voice ids are bare names
# (English-India voices include Priya, Aarav, Anisha, Nikhil).
MURF_API_KEY=
MURF_VOICE_ID=Priya
MURF_LOCALE=en-IN
# Global endpoint (documented). Try wss://in.api.murf.ai/v1/speech/stream-input for the India region.
MURF_WS_URL=wss://global.api.murf.ai/v1/speech/stream-input
MURF_MODEL=FALCON
# Speech recognition language (en-US or en-IN get semantic end-of-turn detection)
# Speech recognition: deepgram (nova-3 on Agora-managed credentials, no Deepgram key) or ares.
ASR_VENDOR=deepgram
# Empty: en for Deepgram, en-US for ARES (en-IN also works with ARES).
ASR_LANGUAGE=
# Selective Attention Locking (beta): lock onto the speaker, block background voices. 0 turns it off.
NOISE_LOCK=1
# Optional turn-detection tuning; leave empty for Agora's defaults.
# semantic (waits for a finished thought) or vad (fixed 640 ms silence)
END_OF_SPEECH=
# ms of speech needed to interrupt Vox (Agora's default is 160)
INTERRUPT_MS=
# Model tier for Vox's conversation (jnr = the fast model)
# Empty: gpt-oss-20b on Groq, the jnr model elsewhere. Or jnr, snr, architect.
VOX_LLM_TIER=

# Public https URL of this backend. Agora's cloud calls {PUBLIC_BASE_URL}/llm/... every turn.
# Locally: `cloudflared tunnel --url http://localhost:8000` or `ngrok http 8000`.
PUBLIC_BASE_URL=
# Any long random string. Signs the per-session token Agora sends to /llm.
TOOL_SECRET=

# Seconds a voice tool call waits for a job before saying "working on it"
TOOL_SYNC_WAIT=8
# Set to 0 to skip the design critic's review pass on new sites (one fewer model call).
# DESIGN_CRITIC=1

# --- LLM that writes the website -------------------------------------------
# Users can also add their own keys in the app's Settings; these are used after theirs.
# Each variable may hold several comma-separated keys, rotated when one is rate limited.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: better stock photos for the researcher (free key: https://www.pexels.com/api/).
# Without it, photos come from Wikimedia Commons.
PEXELS_API_KEY=
# Optional, tried first: Unsplash access key (https://unsplash.com/developers). Photos are hotlinked, as Unsplash requires.
UNSPLASH_ACCESS_KEY=

# Optional: force a provider (anthropic | openai | gemini | groq) or override tier models
# LLM_PROVIDER=
# MODEL_JNR=
# MODEL_SNR=
# MODEL_ARCHITECT=

# --- Accounts (optional) ----------------------------------------------------
# Signs session cookies and encrypts stored GitHub tokens / user API keys.
# If unset, a random one is generated and kept in data/.session_secret.
SESSION_SECRET=
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
#   Authorized redirect URI: <your site>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers > New OAuth App
#   Authorization callback URL: <your site>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
