{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND-HOST/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://YOUR-BACKEND-HOST/auth/:path*" },
    { "source": "/preview/:path*", "destination": "https://YOUR-BACKEND-HOST/preview/:path*" },
    { "source": "/preview-inject.js", "destination": "https://YOUR-BACKEND-HOST/preview-inject.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
